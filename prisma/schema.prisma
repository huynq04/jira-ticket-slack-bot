generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model JiraTicketMapping {
  id           String   @id @default(cuid())
  platform     String
  workspaceId  String
  channelId    String
  messageId    String
  messageUrl   String?
  messageHash  String
  jiraIssueKey String
  jiraIssueUrl String
  createdBy    String
  createdAt    DateTime @default(now())
  status       String

  @@unique([platform, workspaceId, channelId, messageId])
  @@index([messageHash])
}

model JiraProjectConfig {
  id                      String   @id @default(cuid())
  platform                String
  workspaceId             String
  channelId               String?
  jiraProjectKey          String
  defaultIssueType        String
  defaultPriority         String
  defaultAssignee         String?
  componentMapping        Json?
  severityPriorityMapping Json?
  active                  Boolean  @default(true)
  createdAt               DateTime @default(now())

  @@index([platform, workspaceId, channelId, jiraProjectKey, active])
}

model JiraTicketAuditLog {
  id              String   @id @default(cuid())
  action          String
  platform        String?
  channelId       String?
  messageId       String?
  jiraIssueKey    String?
  actor           String?
  requestPayload  Json?
  responsePayload Json?
  errorMessage    String?
  createdAt       DateTime @default(now())

  @@index([action])
  @@index([platform, channelId, messageId])
}

model SlackJiraProjectMapping {
  id               String   @id @default(cuid())
  slackTeamId      String   @map("slack_team_id")
  slackChannelId   String   @map("slack_channel_id")
  slackChannelName String?  @map("slack_channel_name")
  jiraProjectKey   String   @map("jira_project_key")
  defaultIssueType String   @default("Bug") @map("default_issue_type")
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@unique([slackTeamId, slackChannelId])
  @@index([slackTeamId, slackChannelId, isActive])
  @@map("slack_jira_project_mapping")
}

model SlackJiraUserMapping {
  id              String   @id @default(cuid())
  slackUserId     String?  @map("slack_user_id")
  slackUsername   String?  @map("slack_username")
  jiraAccountId   String   @map("jira_account_id")
  jiraDisplayName String?  @map("jira_display_name")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([slackUserId, isActive])
  @@index([slackUsername, isActive])
  @@map("slack_jira_user_mapping")
}
