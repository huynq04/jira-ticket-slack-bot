PORT=3000
NGROK_AUTHTOKEN=change-me
NGROK_DOMAIN=your-static-domain.ngrok-free.app

DATABASE_URL=postgresql://user:password@localhost:5432/jira_ticket_bot

JIRA_BASE_URL=https://company.atlassian.net
